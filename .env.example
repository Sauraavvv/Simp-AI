# LLM API Key (Groq / OpenAI / OpenRouter / Anthropic)
# Several keys for the same provider rotate round-robin -- comma-separate them:
#   LLM_API_KEY=gsk_first,gsk_second
LLM_API_KEY=your_llm_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional LLM Model Override
LLM_MODEL=openai/gpt-oss-120b

# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_atlas_connection_string_here
MONGODB_DB=mantraa_ai

# Python Agent Backend URL.
# Local: the uvicorn process from `npm run dev:api`.
# Deployed: the Render service URL, e.g. https://nexus-agent.onrender.com
AGENT_URL=http://127.0.0.1:8000

# Shared secret proving a request to the agent came from this app. Leave empty
# locally (the agent is only on 127.0.0.1); set the SAME value on Vercel and on
# Render once they are deployed apart, or every proxied call gets a 401.
AGENT_TOKEN=

# Answering scope: `off` answers any subject.
TOPIC_POLICY=off

# What the assistant calls itself when asked who it is (server/policy.py).
ASSISTANT_NAME=Nexus

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Optional: spoken replies (KittenTTS -- https://github.com/KittenML/KittenTTS)
# Install with `npm run setup:tts`; without it the speaker button stays disabled.
# Voices: Bella, Jasper, Luna, Bruno, Rosie, Hugo, Kiki, Leo
KITTEN_TTS_MODEL=KittenML/kitten-tts-mini-0.8
KITTEN_TTS_VOICE=Luna

# Hindi replies are spoken by a separate model, picked automatically when the
# text is written in Devanagari. See server/tts.py.
HINDI_TTS_MODEL=facebook/mms-tts-hin

# Image generation (server/images.py).
# Nothing here is required: with no key at all the tool uses Pollinations/FLUX,
# which is free and needs no account. A key switches provider automatically:
#   hf_...      -> Hugging Face, FLUX.1-schnell
#   tgp_v1_...  -> Together AI, FLUX.1-schnell-Free
#   sk-...      -> OpenAI, gpt-image-1
#   AIza...     -> Google, gemini-2.5-flash-image
IMAGE_API_KEY=
# Optional overrides: force a provider by name, a model, or any
# OpenAI-compatible /images/generations endpoint.
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_BASE_URL=
# Generated pictures are stored in MongoDB and deleted after this many days --
# a 1024px PNG is over a megabyte, and Atlas' free tier is 512MB. 0 keeps them.
IMAGE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Text to video (server/video.py)
# ---------------------------------------------------------------------------
# Unlike images, this has NO free tier. Every video model bills per second of
# output, and an unauthenticated request is refused outright -- so with this
# unset the Video Generator page says it is off and the agent is never offered
# the tool at all. Get a key at https://enter.pollinations.ai/keys and fund it;
# Pollinations bills in "pollen" at 1 pollen = 1 USD.
VIDEO_API_KEY=
# Which model, and therefore both the price and the lengths on offer. The UI
# reads the model's real limits, so changing this changes the buttons:
#
#   seedance-pro     $0.025/s   5s, 10s          (default -- cheapest that is good)
#   p-video          $0.02/s    5s, 10s
#   grok-video-pro   $0.07/s    5s, 10s, 15s     (unlocks the 15s rung)
#   wan              $0.10/s    5s, 10s, 15s     (720p with synced audio)
#
# No model generates 20 seconds in one pass -- 15s is the ceiling everywhere.
VIDEO_MODEL=
VIDEO_BASE_URL=
# Clips are stored inline in MongoDB and deleted after this many days. Shorter
# than images on purpose: a 720p clip is several MB where a PNG is one, so the
# same window would fill a 512MB cluster far faster. 0 keeps them forever.
VIDEO_RETENTION_DAYS=14

# Optional: LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Chat-app
