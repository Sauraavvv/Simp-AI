# LLM API Key (Groq / OpenAI / OpenRouter / Anthropic)
# Several keys for the same provider rotate round-robin -- comma-separate them:
#   LLM_API_KEY=gsk_first,gsk_second
LLM_API_KEY=your_llm_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional LLM Model Override
LLM_MODEL=openai/gpt-oss-120b

# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_atlas_connection_string_here
MONGODB_DB=mantraa_ai

# Python Agent Backend URL.
# Local: the uvicorn process from `npm run dev:api`.
# Deployed: the Render service URL, e.g. https://simp-agent.onrender.com
AGENT_URL=http://127.0.0.1:8000

# Shared secret proving a request to the agent came from this app. Leave empty
# locally (the agent is only on 127.0.0.1); set the SAME value on Vercel and on
# Render once they are deployed apart, or every proxied call gets a 401.
AGENT_TOKEN=

# What the assistant calls itself when asked who it is (server/policy.py).
ASSISTANT_NAME=SIMP

# Voyage AI embeddings for document RAG (server/rag.py). A document attached
# past MAX_CHARS is chunked, embedded and indexed in MongoDB Atlas Vector
# Search instead of being pasted whole into context.
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional: spoken replies (KittenTTS -- https://github.com/KittenML/KittenTTS)
# Install with `npm run setup:tts`; without it the speaker button stays disabled.
# Voices: Bella, Jasper, Luna, Bruno, Rosie, Hugo, Kiki, Leo
KITTEN_TTS_MODEL=KittenML/kitten-tts-mini-0.8
KITTEN_TTS_VOICE=Luna

# Hindi replies are spoken by a separate model, picked automatically when the
# text is written in Devanagari. See server/tts.py.
HINDI_TTS_MODEL=facebook/mms-tts-hin

# Web search provider (server/websearch.py). DuckDuckGo is scraped and free
# but does not answer from a datacenter -- it hangs rather than refusing, so
# a deployed agent needs a keyed provider. With this set Tavily runs first and
# DuckDuckGo is the fallback; unset, DuckDuckGo is the only provider, which is
# what keeps a fresh clone working with nothing to sign up for.
# Free tier: 1,000 searches/month, no card. https://tavily.com
TAVILY_API_KEY=

# Accounts exempt from every per-account quota (the one-RAG-per-account cap in
# particular) -- the developer's own, so the app can be exercised end to end
# without burning the allowance it hands everyone else. Comma-separated.
DEVELOPER_EMAILS=

# Google Sign-In (src/app/api/auth/google). Client ID only -- the ID token is
# verified server-side with google-auth-library, no client secret needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Chat-app
